{
  // 正式站部署設定：Cloudflare Workers 靜態資產。
  //
  // 為什麼是 Workers 不是 Pages：Cloudflare 官方文件現在每一頁 Pages 都掛著
  // 「Are you sure you want to use Pages?」，新專案一律建議走 Workers。這個站目前是
  // 純靜態匯出（next.config.ts 的 output: "export"），兩邊都跑得起來，選 Workers 是為了
  // 之後要加 API / D1 / R2 的時候不用再搬一次家。
  //
  // 部署在**客戶名下**的 Cloudflare 帳號（見 00-plan/MIGRATION-PLAN.md 帳號歸屬原則），
  // 接案方用 Super Administrator 成員身分操作。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wasupstudio",

  // 客戶名下的 Cloudflare 帳號（接案方是 Super Administrator）。
  //
  // 為什麼要釘在這裡（2026-10-14 實測）：接案方的 token 同時看得到三個帳號，而 wrangler
  // 在沒有 account_id、也沒有 CLOUDFLARE_ACCOUNT_ID 的時候**不會停下來問要哪一個**，
  // 它安靜挑第一個（接案方的個人帳號）。不帶變數跑
  // `npx wrangler deployments list --name wasupstudio` 回的是
  // `10007 This Worker does not exist on your account`，也就是說一個沒帶變數的
  // `wrangler deploy` 會在個人帳號新建一個同名 worker、而且回報成功，
  // 客戶的正式站一動也沒動。驗法：把這一行註解掉再跑上面那個指令，要回到 10007。
  "account_id": "4d4c15bc9ad90313751279aa516bf6a6",

  "compatibility_date": "2026-09-02",

  "assets": {
    // next build（output: "export"）的產物目錄。
    "directory": "./out",

    // 靜態匯出產生的是 about.html 這種檔案，但站上的連結寫的是 /about。
    // auto-trailing-slash 會自動對應，不用改任何連結。
    "html_handling": "auto-trailing-slash",

    // 找不到的路徑吐 Next.js 產生的 404 頁，而不是 Workers 的預設純文字。
    "not_found_handling": "404-page"
  },

  // 保留 workers.dev 網址當備援與預覽用（wasupstudio.wasupstudio.workers.dev）。
  // 不寫的話 wrangler 會在有 routes 時預設關掉它。
  "workers_dev": true,

  // 正式網域。custom_domain 會讓 Cloudflare 自動建立/接管對應的 DNS 記錄，
  // 並簽發憑證，取代原本指向 Weebly IP 的 A 記錄。
  "routes": [
    { "pattern": "wasupstudio.com", "custom_domain": true },
    { "pattern": "www.wasupstudio.com", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }
}
